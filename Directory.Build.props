<Project>

  <!-- Centrale package-metadata voor alle projecten in deze repository. Een csproj kan deze waarden overschrijven. -->
  <PropertyGroup>
    <Authors>Rob Lohmann</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/roblohmann/CodeCube.FluentValidation</PackageProjectUrl>
    <RepositoryUrl>https://github.com/roblohmann/CodeCube.FluentValidation</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <VersionPrefix>3.1.17</VersionPrefix>
  </PropertyGroup>

</Project>
